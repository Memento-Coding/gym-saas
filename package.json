{
  "name": "gym-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "bdd:gen": "bddgen",
    "bdd:test": "bddgen && playwright test",
    "bdd:smoke": "bddgen && playwright test --grep @smoke",
    "bdd:critico": "bddgen && playwright test --grep @critico",
    "bdd:regresion": "bddgen && playwright test --grep @regresion",
    "bdd:cortesias": "bddgen && playwright test --grep @cortesias",
    "bdd:consentimiento": "bddgen && playwright test --grep @consentimiento",
    "bdd:comunicacion": "bddgen && playwright test --grep @comunicacion",
    "bdd:ajustes": "bddgen && playwright test --grep @ajustes",
    "bdd:report": "playwright show-report",
    "bdd:headed": "bddgen && playwright test --headed",
    "bdd:slow": "bddgen && SLOW_STEP_MS=1 SLOW_MO=1500 playwright test --headed",
    "bdd:veryslow": "bddgen && SLOW_STEP_MS=1 SLOW_MO=5000 playwright test --headed",
    "bdd:ui": "bddgen && playwright test --ui",
    "bdd:debug": "bddgen && playwright test --debug"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "aws-amplify": "6.14.4",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "framer-motion": "^13.1.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "playwright-bdd": "^9.2.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
