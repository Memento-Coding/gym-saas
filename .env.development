# ─── Modo de datos ──────────────────────────────────────────────────────────────
# Por defecto el desarrollo usa storage local (IndexedDB + localStorage).
# Cambia a 'api' (o usa .env.local / .env.api) para conectar con la API real.
VITE_API_MODE=local

# ─── Development Auth Bypass ────────────────────────────────────────────────────
# When set to "true", the app skips AWS Cognito authentication and uses a mock
# user. This allows local development without a configured User Pool.
# Remove or set to "false" to use real Cognito authentication.
VITE_AUTH_BYPASS=true

VITE_COGNITO_USER_POOL_ID=us-east-1_6FWDTXZ38
VITE_COGNITO_CLIENT_ID=2ar8jhcuk2pfldad18g6va1246
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_OAUTH_DOMAIN=tu-dominio.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173

# E2E: Force localStorage-only storage for deterministic test data seeding
# Set to "localStorage" when running Playwright tests
VITE_E2E_STORAGE=localStorage
