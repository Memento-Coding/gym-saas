# ─── Development Auth Bypass ────────────────────────────────────────────────────
# When set to "true", the app skips AWS Cognito authentication and uses a mock
# user. This allows local development without a configured User Pool.
# Remove or set to "false" to use real Cognito authentication.
VITE_AUTH_BYPASS=true

# E2E: Force localStorage-only storage for deterministic test data seeding
# Set to "localStorage" when running Playwright tests
VITE_E2E_STORAGE=localStorage
