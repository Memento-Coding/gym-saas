# ─── Modo de datos ──────────────────────────────────────────────────────────────
# 'local' (default) usa IndexedDB + localStorage en el navegador.
# 'api'   conecta con la API REST real de GymOps (API Gateway + Cognito).
VITE_API_MODE=local

# Base URL del API Gateway (obligatoria si VITE_API_MODE=api).
VITE_API_BASE_URL=https://1v25qroyxk.execute-api.us-east-1.amazonaws.com

# ─── Autenticación (AWS Cognito) ─────────────────────────────────────────────────
# Requerido cuando VITE_API_MODE=api y no se usa el bypass.
VITE_COGNITO_USER_POOL_ID=us-east-1_6FWDTXZ38
VITE_COGNITO_CLIENT_ID=2ar8jhcuk2pfldad18g6va1246
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_OAUTH_DOMAIN=
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/login

# ─── Bypass de autenticación (solo desarrollo) ───────────────────────────────────
# 'true' salta Cognito y usa un usuario mock. Úsalo solo con VITE_API_MODE=local.
VITE_AUTH_BYPASS=false

# ─── E2E ─────────────────────────────────────────────────────────────────────────
# 'localStorage' fuerza storage local determinista para Playwright.
# VITE_E2E_STORAGE=localStorage
